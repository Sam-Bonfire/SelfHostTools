{
  "name": "selfhosttools",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:style": "pnpm --filter @packages/styling run --if-present build",
    "clean": "npx rimraf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist coverage",
    "dev": "pnpm --filter calculators dev",
    "dev:calc": "pnpm --filter calculators dev",
    "dev:viz": "pnpm --filter visualizers dev",
    "format": "prettier --write .",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint --fix",
    "setup": "pnpm install",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.19"
  }
}
